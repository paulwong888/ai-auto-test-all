# ── Compose ─────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ai-auto-test-monday

# ── 端口 ────────────────────────────────────────────────────
DASHBOARD_PORT=8040
API_PORT=3010
TEMPORAL_UI_PORT=8088

# ── Temporal ────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
# UI 由 temporal-ui 容器提供（auto-setup 不含 Web UI）
TEMPORAL_UI_VERSION=2.31.2

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── 业务 Postgres（宿主机 ai-middleware :5433）──────────────
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5433
POSTGRES_DB=ai_auto_test_monday
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Artifact / Repos ────────────────────────────────────────
ARTIFACTS_BASE_DIR=/data/artifacts
REPOS_BASE_DIR=/data/repos
EXTERNAL_REPOS_HOST_PATH=/app/home/paul/workspaces/cs-help-desk-workspaces
EXTERNAL_REPOS_CONTAINER_PATH=/data/repos/external
# 平台 sandbox 父目录（一次挂载；项目 localPathOverride 在 Dashboard/DB 配置，见 README）
SANDBOX_REPOS_HOST_PATH=/app/home/paul/workspaces/ai-auto-test-all/ai-auto-test-platform/sandbox-repos
SANDBOX_REPOS_CONTAINER_PATH=/data/repos/sandbox

# ── Git SSH（api 容器 clone 私有仓）────────────────────────
GIT_SSH_HOST_PATH=/home/paul/.ssh

# ── LLM（M2+ Agent 使用）────────────────────────────────────
HIGRESS_BASE_URL=http://host.docker.internal:8004/v1
HIGRESS_API_KEY=not-needed
LLM_MODEL=ds-v4-flash-0731-dspark
# Qwen thinking 级别（DeepSeek 可留空）：xhigh / medium / low
# LLM_REASONING_EFFORT=medium
LLM_TIMEOUT=900
CHOREOGRAPHER_LLM_TIMEOUT=600
# SSE 流式（默认开启）；设为 false 回退非流式
LLM_STREAM_ENABLED=true
# 相邻 stream chunk 最大空闲秒数（非整次请求总超时）
LLM_STREAM_CHUNK_TIMEOUT=600
SCAN_MAX_FILES=300
SCAN_MAX_COMPONENTS=80
JOURNEY_MIN=5
JOURNEY_MAX=8
POM_BATCH_SIZE=5
CHOREOGRAPHER_BATCH_SIZE=8
FULL_COVERAGE=true

# ── Platform 执行桥接（Agent 7）────────────────────────────
PLATFORM_BASE_URL=http://host.docker.internal:3001
PLATFORM_EXECUTION_ENABLED=true
EXECUTION_MODE=auto
# PLAYWRIGHT_CLI_PATH=/app/sandbox-repos/demo-app/node_modules/@playwright/test/cli.js
# PLAYWRIGHT_NODE_PATH=/app/sandbox-repos/demo-app/node_modules
