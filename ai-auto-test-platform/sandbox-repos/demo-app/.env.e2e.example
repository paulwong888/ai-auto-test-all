PLAYWRIGHT_BASE_URL=http://host.docker.internal:8037

# 单账号（默认）
E2E_USERNAME=your_username
E2E_PASSWORD=your_password

# 多角色 Gherkin（可选）
E2E_CASE_USERNAME=your_case_username
E2E_CASE_PASSWORD=your_case_password
E2E_CORP_USERNAME=your_corp_username
E2E_CORP_PASSWORD=your_corp_password
E2E_UNKNOWN_USERNAME=your_unknown_username
E2E_UNKNOWN_PASSWORD=your_unknown_password
