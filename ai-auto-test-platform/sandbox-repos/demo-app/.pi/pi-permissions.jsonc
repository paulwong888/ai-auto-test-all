{
  "defaultPolicy": {
    "tools": "deny",
    "bash": "deny"
  },
  "tools": {
    "read": "allow",
    "write": "allow",
    "edit": "allow"
  },
  "bash": {
    "node /app/sandbox-repos/demo-app/node_modules/@playwright/test/cli.js test *": "allow",
    "NODE_PATH=* node * @playwright/test/cli.js test *": "allow",
    "NODE_PATH=* PLAYWRIGHT_BASE_URL=* node * test *": "allow"
  }
}
