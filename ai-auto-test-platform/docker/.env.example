# ── Docker Compose ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=ai-test-platform

# ── 容器名称 ────────────────────────────────────────────────
SERVER_CONTAINER_NAME=ai-test-platform-server
DASHBOARD_CONTAINER_NAME=ai-test-platform-dashboard

# ── 端口映射（宿主机 0.0.0.0） ───────────────────────────────
DASHBOARD_PORT=8036
SERVER_PORT=3001

# ── 后端 (test-server) ──────────────────────────────────────
HOST=0.0.0.0
PORT=3001
PI_CLI_PATH=pi
PI_RPC_ARGS=--no-session
AUDIT_TIMEOUT_MS=600000
AUDIT_MODULE_TIMEOUT_MS=600000
AUDIT_FULL_ENABLED=true
AUDIT_JOBS_DIR=/data/platform/audit-jobs
RUN_TIMEOUT_MS=900000

# 被测应用 URL（Playwright 访问地址，用于 seed 默认 demo-app 项目）
TARGET_APP_URL=http://host.docker.internal:8037

# 容器内沙箱路径（勿改，与 Dockerfile 布局一致）
SANDBOX_REPO=/app/sandbox-repos/demo-app
SANDBOX_REPOS_CONTAINER_PATH=/app/sandbox-repos

# 宿主机沙箱目录（可选：供审计读取源码，与 demo-app 运行时无关）
SANDBOX_REPOS_HOST_PATH=../sandbox-repos

# 外部项目挂载（宿主机目录 → 容器 /data/repos）
EXTERNAL_REPOS_HOST_PATH=/app/home/paul/workspaces/cs-help-desk-workspaces
EXTERNAL_REPOS_CONTAINER_PATH=/data/repos

# 项目注册表持久化
PROJECTS_FILE=/data/platform/projects.json

# ── Higress LLM 网关（OpenAI 兼容 /v1） ─────────────────────
# 容器通过 host.docker.internal 访问宿主机 Higress（默认 :8004）
# 可用 ./list_endpoints.sh 查看模型列表（higress 目录）
HIGRESS_BASE_URL=http://host.docker.internal:8004/v1
HIGRESS_API_KEY=not-needed
PI_PROVIDER=higress
PI_MODEL=qwen-32b

# 若 Higress 在其他机器，改为实际地址，例如：
# HIGRESS_BASE_URL=http://192.168.x.x:8004/v1

# 若网关启用了 API Key 鉴权，填入真实 Key：
# HIGRESS_API_KEY=sk-xxxx
