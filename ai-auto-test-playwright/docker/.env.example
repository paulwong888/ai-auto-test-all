COMPOSE_PROJECT_NAME=ai-auto-test-playwright
# 宿主机映射端口（浏览器/curl 直连 API：http://host:${SERVER_PORT}）
SERVER_PORT=3001
# 容器内 API 监听端口；须与 dashboard/nginx.conf 的 server:3001 一致，勿与 SERVER_PORT 混为一谈
PORT=3001
HOST=0.0.0.0

POSTGRES_CONTAINER_NAME=ai-auto-test-playwright-postgres
POSTGRES_HOST_PORT=5434
POSTGRES_DB=ai_auto_test_playwright
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

SERVER_CONTAINER_NAME=ai-auto-test-playwright-server

# Dashboard Web UI（M4，nginx 反代 /api /ws → server:${PORT}，默认 3001）
DASHBOARD_PORT=8040
DASHBOARD_CONTAINER_NAME=ai-auto-test-playwright-dashboard
ALLOWED_REPO_PREFIXES=/data/projects
PROJECTS_DATA_PATH=/data/projects
PROJECTS_DATA_HOST_PATH=./data/projects

# Python pytest Worker（M3，容器内 8081）
WORKER_URL=http://worker:8081
WORKER_CONTAINER_NAME=ai-auto-test-playwright-worker
# Run 期 noVNC：Server 经 Docker 内网代理至 Worker websockify（一般无需映射到宿主机）
WORKER_VNC_HOST=worker
WORKER_VNC_PORT=6080
RUN_TIMEOUT_MS=600000

# LLM / Pi 配置见 .env.local.example（复制为 .env.local 后填入 DASHSCOPE_API_KEY）
