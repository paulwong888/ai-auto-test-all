COMPOSE_PROJECT_NAME=ai-auto-test-playwright
SERVER_PORT=3002
PORT=3002
HOST=0.0.0.0

POSTGRES_CONTAINER_NAME=ai-auto-test-playwright-postgres
POSTGRES_HOST_PORT=5434
POSTGRES_DB=ai_auto_test_playwright
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Infra mode (auto-detected by start.sh when unset):
# USE_LOCAL_POSTGRES=1|0   — 1=host postgres, 0=compose postgres
# USE_LOCAL_REDIS=1|0      — 1=host redis, 0=compose redis
LOCAL_POSTGRES_PORTS="5432 5433"
LOCAL_POSTGRES_HOST=host.docker.internal
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_HOST=host.docker.internal
REDIS_HOST_PORT=6379
REDIS_CONTAINER_NAME=ai-auto-test-playwright-redis

SERVER_CONTAINER_NAME=ai-auto-test-playwright-server

# Dashboard Web UI（M4，nginx 反代 /api /ws）
# 8041 常与 monday/next 冲突；本机可固定 8042
DASHBOARD_PORT=8042
DASHBOARD_CONTAINER_NAME=ai-auto-test-playwright-dashboard
ALLOWED_REPO_PREFIXES=/data/projects
PROJECTS_DATA_PATH=/data/projects
PROJECTS_DATA_HOST_PATH=./data/projects

# Web 录制（Phase 3，server 按需 spawn；start.sh 会自动 build）
RECORDER_IMAGE=ai-auto-test-playwright-recorder:latest
RECORDER_BUILD=1
# 内网/自签 HTTPS 站点录制（Sales Portal 等）；0=严格校验证书
RECORDER_IGNORE_HTTPS_ERRORS=1

# Python pytest Worker（M3，容器内 8081）
WORKER_URL=http://worker:8081
WORKER_CONTAINER_NAME=ai-auto-test-playwright-worker
RUN_TIMEOUT_MS=600000

# LLM / Pi 配置见 .env.local.example（复制为 .env.local 后填入 DASHSCOPE_API_KEY）
