# ── 阿里云百炼 DashScope（OpenAI 兼容模式）──
# 复制为 .env.local 后填入真实 Key（勿提交 Git）
# API Key：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-替换为你的Key

# 地域 Base URL（Key 与地域必须匹配，选一个取消注释）
# 北京（默认）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 新加坡
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 模型 id（须支持 tool calling，Pi 依赖）
PI_MODEL=qwen-plus
PI_PROVIDER=dashscope

# Pi CLI
PI_CLI_PATH=pi
PI_RPC_ARGS=--no-session
RUN_TIMEOUT_MS=600000

# ── Git（Wave 3：SSH 公钥，server 容器挂载 ~/.ssh）──
GIT_REPO_URL=git@github.com:paulwong888/ai-auto-test-all.git
GIT_DEFAULT_BRANCH=main
# SSH_DIR=~/.ssh
