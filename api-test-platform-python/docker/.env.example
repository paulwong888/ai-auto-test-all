# ── Docker Compose ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=api-test-platform

# ── 端口映射（宿主机） ───────────────────────────────────────
UI_PORT=8038
API_PORT=8100
LANGGRAPH_PORT=8200

# ── DeepAgents Backend ──────────────────────────────────────
BACKEND_TYPE=local_shell
BACKEND_ROOT_DIR=/app/workspace
BACKEND_VIRTUAL_MODE=false
BACKEND_TIMEOUT=120
BACKEND_INHERIT_ENV=true

# ── AI Model (NPU via Higress OpenAI-compatible /v1) ───────
# 容器通过 host.docker.internal 访问宿主机 Higress（默认 :8004）
# 可用 ai-middleware/higress/list_endpoints.sh 查看模型列表
MODEL_PROVIDER=openai
MODEL_NAME=ds-v4-flash-0731-dspark
OPENAI_API_KEY=not-needed
OPENAI_BASE_URL=http://host.docker.internal:8004/v1

# 若 Higress 启用了 API Key 鉴权，填入真实 Key：
# OPENAI_API_KEY=sk-xxxx

# 若 Higress 在其他机器：
# OPENAI_BASE_URL=http://192.168.x.x:8004/v1

# ── CodeGraph ───────────────────────────────────────────────
CODEGRAPH_PATH=codegraph
CODEGRAPH_DEFAULT_PROJECT=/data/repos/casemanagementapi-maven

# ── API Test Workspace ──────────────────────────────────────
API_TEST_DIR=/app/workspace/test_suites/casemanagementapi-maven

# ── 外部项目挂载（Case Management 后端 API）──────────────────
EXTERNAL_REPOS_HOST_PATH=/app/home/paul/workspaces/cs-help-desk-workspaces/casemanagementapi-maven
EXTERNAL_REPOS_CONTAINER_PATH=/data/repos/casemanagementapi-maven
CRM_CASE_BASE_URL=http://172.26.9.212:8027/case

# ── Database (外部 Postgres，如 ai-cs-faq-postgres 宿主机 5433) ─
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5433
POSTGRES_DB=api_test_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Redis (Compose 内置，容器内 redis:6379) ─────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Server ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8100
LANGGRAPH_PORT=8200

# ── LangSmith (可选) ────────────────────────────────────────
# LANGSMITH_API_KEY=
